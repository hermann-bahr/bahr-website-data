    "body": {
      "value": "Am 25. Mai 1909 reisen Bahr und Anna Mildenburg nach Villach, am 26. weiter nach Venedig. Am 28. und 29. trifft er auf Kvapil am Lido. Am 22. Juni brechen sie nach Bayreuth auf, wo er am 24. von Kufstein kommend eintrifft.",
      "format": "full_html",
      "processed": "Am 25. Mai 1909 reisen Bahr und Anna Mildenburg nach Villach, am 26. weiter nach Venedig. Am 28. und 29. trifft er auf Kvapil am Lido. Am 22. Juni brechen sie nach Bayreuth auf, wo er am 24. von Kufstein kommend eintrifft.",
      "summary": null
    },
    "field_event_date": {
      "value": "1909-05-25",
      "end_value": "1909-06-23"
