    "body": {
      "value": "<h3 id=\"bib\">Bibliografie</h3>\r\n<table class=\"bibliografie\">\r\n<tr><td>Autor:</td><td>Hermann Bahr</td></tr>\r\n<tr><td>Titel:</td><td>Henrik Ibsen</td></tr>\r\n<tr><td> </td><td>Sonderabdruck aus dem 8. und 9. (August-September-) Heft der \"Deutschen Worte\"</td></tr>\r\n<tr><td>Stadt:</td><td>Wien</td></tr>\r\n<tr><td>Verlag:</td><td>Verlag der Deutschen Worte (Engelbert Pernerstorfer)</td></tr>\r\n<tr><td>Jahr:</td><td>1887</td></tr>\r\n<tr><td> </td></tr>\r\n<tr><td>Seiten:</td><td>18</td></tr>\r\n<tr><td>Anm.:</td><td>Bahr konnte seinem Vater am 14.11.1887 für die \"nächsten Tage\" drei Exemplare versprechen.</td></tr></table>\r\n\r\n<h3 id=\"digit\">Digitalisat</h3>\r\n\r\n<a href=\"/bahr/sites/all/txt/deutsche-worte/1887_ibsen_sonderabdruck.pdf\">[Text]</a>",
      "format": "full_html",
