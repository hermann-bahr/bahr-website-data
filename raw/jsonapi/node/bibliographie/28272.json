    },
    "body": {
      "value": "<h3 id=\"bib\">Bibliografie</h3>\r\n<table class=\"bibliografie\">\r\n<tr><td>Autor:</td><td>Hermann Bahr</td></tr>\r\n<tr><td>Titel:</td><td>Die Einsichtslosigkeit des Herrn Schäffle</td></tr>\r\n<tr><td> </td><td>Drei Briefe an einen Volksmann als Antwort auf \"Die Aussichtslosigkeit der Sozialdemokratie\"</td></tr>\r\n<tr><td>Ort:</td><td>Zürich</td></tr>\r\n<tr><td>Verlag:</td><td>J. Schabelitz</td></tr>\r\n<tr><td>Jahr:</td><td>1886</td></tr>\r\n<tr><td>Seiten:</td><td>95</td></tr>\r\n<tr><td>Übers.:</td><td>Ein Auszug auf Schwedisch als \"Individualism och Socialism\"</td></tr>\r\n<tr><td>Anm.:</td><td>Das Buch ist auf 1886 vordatiert. Am 26.7.1885 kündigt er seinem Vater den Erhalt \"einer Broschüre von mir\" für die nächsten Tage an. Die Deutsche Schriftsteller-Zeitung, 1 (1885) #16, 390 (15.8.1885) verzeichnet es als erschienen. </td></tr></table>\r\n<h3 id=\"rezens\">Rezensionen</h3>\r\n<p>Der Sozialdemokrat, Zürich, 6.8.1885, 3.\r\nKölnische Zeitung, 16.8.1885, 1\r\nDeutsche Worte,  (1885) #10, 344-347 \r\nLinzer Volksblatt, 30.10.1885, 3.</p>\r\n\r\n<h3 id=\"digit\">Digitalisate</h3>\r\n\r\n<a href=\"http://anno.onb.ac.at/cgi-content/anno-buch?apm=0&aid=37\">ANNO</a> [Aus Bahrs Nachlass]\r\n<a href=\"http://www.archive.org/search.php?query=bahr%20schäffle\">Archive.org</a>",
      "format": "full_html",
      "processed": "<h3 id=\"bib\">Bibliografie</h3>\n<table class=\"bibliografie\">\n<tr><td>Autor:</td><td>Hermann Bahr</td></tr>\n<tr><td>Titel:</td><td>Die Einsichtslosigkeit des Herrn Schäffle</td></tr>\n<tr><td> </td><td>Drei Briefe an einen Volksmann als Antwort auf \"Die Aussichtslosigkeit der Sozialdemokratie\"</td></tr>\n<tr><td>Ort:</td><td>Zürich</td></tr>\n<tr><td>Verlag:</td><td>J. Schabelitz</td></tr>\n<tr><td>Jahr:</td><td>1886</td></tr>\n<tr><td>Seiten:</td><td>95</td></tr>\n<tr><td>Übers.:</td><td>Ein Auszug auf Schwedisch als \"Individualism och Socialism\"</td></tr>\n<tr><td>Anm.:</td><td>Das Buch ist auf 1886 vordatiert. Am 26.7.1885 kündigt er seinem Vater den Erhalt \"einer Broschüre von mir\" für die nächsten Tage an. Die Deutsche Schriftsteller-Zeitung, 1 (1885) #16, 390 (15.8.1885) verzeichnet es als erschienen. </td></tr></table>\n<h3 id=\"rezens\">Rezensionen</h3>\n<p>Der Sozialdemokrat, Zürich, 6.8.1885, 3.\nKölnische Zeitung, 16.8.1885, 1\nDeutsche Worte,  (1885) #10, 344-347 \nLinzer Volksblatt, 30.10.1885, 3.</p>\n\n<h3 id=\"digit\">Digitalisate</h3>\n\n<a href=\"http://anno.onb.ac.at/cgi-content/anno-buch?apm=0&amp;aid=37\">ANNO</a> [Aus Bahrs Nachlass]\n<a href=\"http://www.archive.org/search.php?query=bahr%20schäffle\">Archive.org</a>",
