    "body": {
      "value": "<h3 id=\"bib\">Bibliografie</h3>\r\n<table class=\"bibliografie\">\r\n<tr><td>Autor:</td><td>Hermann Bahr</td></tr>\r\n<tr><td>Titel:</td><td>Mensch, werde wesentlich</td></tr>\r\n<tr><td> </td><td>Gedanken aus seinen Werken. Auswahl von Anna Bahr-Mildenburg. Anordnung von Paul Graf Thun-Hohenstein. Mit einem Vorwort von Dr. Josef Nadler</td></tr>\r\n<tr><td>Ort:</td><td>Graz</td></tr>\r\n<tr><td>Verlag:</td><td>Styria</td></tr>\r\n<tr><td>Jahr:</td><td>1934</td></tr>\r\n<tr><td>Seiten:</td><td>208</td></tr>\r\n<tr><td>Aufl.:</td><td>1.-2. Tsd.</td></tr>\r\n\r\n<tr><td>Anm.:</td><td>Die im Archiv aufbewahrten Rezensionen datieren das Buch auf Weihnachten 1933. Es war bereits zu Bahrs Lebzeiten fertiggestellt, wie auch ein Exemplar mit seiner Unterschrift beweist.</td></tr></table>",
      "format": "full_html",
      "processed": "<h3 id=\"bib\">Bibliografie</h3>\n<table class=\"bibliografie\">\n<tr><td>Autor:</td><td>Hermann Bahr</td></tr>\n<tr><td>Titel:</td><td>Mensch, werde wesentlich</td></tr>\n<tr><td> </td><td>Gedanken aus seinen Werken. Auswahl von Anna Bahr-Mildenburg. Anordnung von Paul Graf Thun-Hohenstein. Mit einem Vorwort von Dr. Josef Nadler</td></tr>\n<tr><td>Ort:</td><td>Graz</td></tr>\n<tr><td>Verlag:</td><td>Styria</td></tr>\n<tr><td>Jahr:</td><td>1934</td></tr>\n<tr><td>Seiten:</td><td>208</td></tr>\n<tr><td>Aufl.:</td><td>1.-2. Tsd.</td></tr>\n\n<tr><td>Anm.:</td><td>Die im Archiv aufbewahrten Rezensionen datieren das Buch auf Weihnachten 1933. Es war bereits zu Bahrs Lebzeiten fertiggestellt, wie auch ein Exemplar mit seiner Unterschrift beweist.</td></tr></table>",
      "summary": null
    }
