    "body": {
      "value": "<h3 id=\"bib\">Bibliografie</h3>\r\n\r\n<table class=\"bibliografie\"><tr><td>Autor:</td><td>Hermann Bahr</td></tr>\r\n<tr><td>Titel:</td><td>Über Rodbertus</td></tr>\r\n<tr><td> </td><td>Vortrag. Mit einem Vorworte des Verfassers</td></tr>\r\n<tr><td>Ort:</td><td>Wien</td></tr>\r\n<tr><td>Verlag:</td><td>Verl. der \"Unverfälschten Deutschen Worte\" (Georg Ritter von Schönerer)</td></tr>\r\n<tr><td>Jahr:</td><td>1884</td></tr>\r\n<tr><td>Seiten:</td><td>27</td></tr>\r\n<tr><td>Anm.</td><td>\"Sonder-Abdruck aus Nr. 20 der 'Unverfälschten Deutschen Worte' vom 16. Oktober 1884\".</td>\r\n</table>\r\n\r\n<h3 id=\"erstdrucke\">Erstdruck</h3>\r\n\r\n<p>Hermann Bahr: Über Rodbertus. Ein Vortrag. Unverfälschte deutsche Worte, 2 (1884) #20, 4-8. (16.10.1884)</p>\r\n\r\n<h3 id=\"digit\">Digitalisate</h3>\r\n\r\n<a href=\"http://anno.onb.ac.at/cgi-content/anno-buch?apm=0&aid=35&teil=0101&seite=00000001\">Sonder-Druck auf ANNO</a>\r\n<a href=\"http://www.univie.ac.at/bahr/sites/all/txt/unverfaelschte-deutsche-worte/1884_rodbertus.pdf\">Erstdruck</a>",
      "format": "full_html",
