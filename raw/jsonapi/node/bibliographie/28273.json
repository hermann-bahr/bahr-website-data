    "body": {
      "value": "<h3 id=\"bib\">Bibliografie</h3>\r\n<table class=\"bibliografie\">\r\n<tr><td>Autor:</td><td>Hermann Bahr</td></tr>\r\n<tr><td>Titel:</td><td>Individualism och Socialism</td></tr>\r\n<tr><td> </td><td>En framställning af den socialistika verldsåskådningen i hennes förhallånde till den bestående. Bemindigad svensk öfversättning af G. F. S. (= G. F. Steffen)</td></tr>\r\n<tr><td>Ort:</td><td>Stockholm</td></tr>\r\n<tr><td>Verlag:</td><td>Carl Suneson</td></tr>\r\n<tr><td>Jahr:</td><td>1886</td></tr>\r\n<tr><td>Seiten:</td><td>31</td></tr>\r\n<tr><td>Anm.:</td><td>Am 4.7.1886 fragt Bahr seinen Vater brieflich an, ob dieser diese \"Broschüre\" schon erhalten habe. Es handelt sich um einen Auszug aus \"Die Einsichtslosigkeit des Herrn Schäffle\".</td></tr></table>",
      "format": "full_html",
      "processed": "<h3 id=\"bib\">Bibliografie</h3>\n<table class=\"bibliografie\">\n<tr><td>Autor:</td><td>Hermann Bahr</td></tr>\n<tr><td>Titel:</td><td>Individualism och Socialism</td></tr>\n<tr><td> </td><td>En framställning af den socialistika verldsåskådningen i hennes förhallånde till den bestående. Bemindigad svensk öfversättning af G. F. S. (= G. F. Steffen)</td></tr>\n<tr><td>Ort:</td><td>Stockholm</td></tr>\n<tr><td>Verlag:</td><td>Carl Suneson</td></tr>\n<tr><td>Jahr:</td><td>1886</td></tr>\n<tr><td>Seiten:</td><td>31</td></tr>\n<tr><td>Anm.:</td><td>Am 4.7.1886 fragt Bahr seinen Vater brieflich an, ob dieser diese \"Broschüre\" schon erhalten habe. Es handelt sich um einen Auszug aus \"Die Einsichtslosigkeit des Herrn Schäffle\".</td></tr></table>",
      "summary": null
    }
