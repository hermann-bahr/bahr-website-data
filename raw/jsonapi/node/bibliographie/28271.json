    "body": {
      "value": "<h3 id=\"bib\">Bibliografie</h3>\r\n\r\n<table class=\"bibliografie\"><tr><td>Autor:</td><td>Hermann Bahr</td></tr>\r\n<tr><td>Titel:</td><td>Rodbertus' Theorie der Absatzkrisen</td></tr>\r\n<tr><td> </td><td>Ein Vortrag</td></tr>\r\n<tr><td>Ort:</td><td>Wien</td></tr>\r\n<tr><td>Verlag:</td><td>Carl Konegen</td></tr>\r\n<tr><td>Jahr:</td><td>1884</td></tr>\r\n<tr><td>Seiten:</td><td>33</td></tr>\r\n<tr><td>Anm.</td><td>\"Gewidmet dem Herren von Rinbach in deutscher Treue.\" </td></tr>\r\n</td></tr></table>\r\n\r\n<h3 id=\"rezens\">Rezensionen</h3>\r\n<p>Niederösterreichische Landeszeitung, 20.9.1884\r\nUnverfälschte Deutsche Worte, 2 (1884) #24, 17-18. (16.12.1884)\r\n</p>\r\n\r\n<h3 id=\"digit\">Digitalisate</h3>\r\n\r\n<a href=\"http://anno.onb.ac.at/cgi-content/anno-buch?apm=0&aid=36\">ANNO</a>\r\n<a href=\"http://www.archive.org/details/rodbertustheori00bahrgoog\">Archive.org</a>",
