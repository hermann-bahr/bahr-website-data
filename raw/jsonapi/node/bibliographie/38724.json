    "body": {
      "value": "<h3 id=\"bib\">Bibliografie</h3>\r\n<table class=\"bibliografie\">\r\n<tr><td>Autor:</td><td>Hermann Bahr</td></tr>\r\n<tr><td>Titel:</td><td>Der Augenblick Österreichs</td></tr>\r\n\r\n<tr><td>Ort:</td><td>München-Gladbach</td></tr>\r\n<tr><td>Verlag:</td><td>Volksvereins-Druckerei</td></tr>\r\n<tr><td>Reihe:</td><td>Der Weltkrieg, 77</td></tr>\r\n<tr><td>Jahr:</td><td>1918</td></tr>\r\n<tr><td>Seiten:</td><td>16</td></tr></table><h3 id=\"erstdrucke\">Erstdrucke</h3>\r\n\r\n<ol><li>Der Augenblick Österreichs. I. Neues Wiener Journal, 24 (1916) #8227, 6-7. (24.9.1916)</li>\r\n<li>Der Augenblick Österreichs. II. Neues Wiener Journal, 24 (1916) #8231, 5-6. (28.9.1916) </li>\r\n<li>Der Augenblick Österreichs. III. Neues Wiener Journal, 24 (1916) #8234, 6-7. (1.10.1916)</li>\r\n</ol>\r\n<small>Alle Texte verifziert, April 2011</small>\r\n\r\n<h3 id=\"digit\">Digitalisate</h3>\r\n\r\n<a href=\"http://anno.onb.ac.at/cgi-content/anno-buch?apm=0&aid=88\">Anno</a>",
      "format": "full_html",
